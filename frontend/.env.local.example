# Copy to .env.local. Address of the FastAPI backend:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: STUN/TURN servers as JSON. A TURN server makes calls work across strict networks
# (e.g. phone on mobile data + laptop on office Wi-Fi).
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your.turn.server:3478","username":"user","credential":"pass"}]
